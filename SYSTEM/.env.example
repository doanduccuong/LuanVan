APP_ENV=development
DATABASE_URL=postgresql+psycopg://touchpoint:touchpoint@postgres:5432/touchpoint
JWT_SIGNING_KEY=replace-with-a-long-random-value
COOKIE_SECURE=false
INITIAL_USER_EMAIL=manager@example.com
INITIAL_USER_PASSWORD=demo1234
VISION_BASE_URL=http://vision:8001
VISION_REQUEST_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=8388608
FACE_THRESHOLD_ARTIFACT_PATH=/artifacts/face-threshold.json
# Giá trị dưới đây chỉ là cấu hình demo, phải chốt lại trước khi đánh giá.
VISIT_IDLE_TIMEOUT_SECONDS=1800
LATE_EVENT_TOLERANCE_SECONDS=300
SYSTEM_TIMEZONE=Asia/Ho_Chi_Minh
VISION_BACKEND=opencv_demo
DETECTOR_CONFIDENCE_THRESHOLD=0.8
RETINAFACE_VENDOR_PATH=/models/Pytorch_Retinaface
RETINAFACE_WEIGHTS_PATH=/models/mobilenet0.25_Final.pth
DEVICE=cpu
